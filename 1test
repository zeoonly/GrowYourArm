--[[
    EXECUTOR SCRIPT — Area12 Teleport + Steal
    Paste into your executor and execute.
    UI appears instantly at right-center.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer

--==================================================================
-- CONFIG
--==================================================================
local TARGET_NAME = "\231\190\142\230\156\178\229\156\186\230\153\175" -- 美本地图 (verify below)
local COLLECT_LOOPS = 40
local COLLECT_DELAY = 0.08

--==================================================================
-- DESTROY OLD UI
--==================================================================
for _, gui in ipairs(CoreGui:GetChildren()) do
    if gui.Name == "StealGui" then gui:Destroy() end
end
pcall(function()
    for _, gui in ipairs(player:WaitForChild("PlayerGui"):GetChildren()) do
        if gui.Name == "StealGui" then gui:Destroy() end
    end
end)

--==================================================================
-- CREATE UI (in CoreGui — works even if game hides PlayerGui)
--==================================================================
local screenGui = Instance.new("ScreenGui")
