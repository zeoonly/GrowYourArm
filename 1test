--[[
    Instant Right-Center Steal UI
    Place in: StarterPlayer > StarterPlayerScripts (LocalScript)
    Or paste in executor.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================================================================
-- CONFIG
--==================================================================
local TARGET_NAME = "\231\190\142\230\156\178\229\156\186\230\153\175"
local COLLECT_LOOPS = 30
local COLLECT_DELAY = 0.1

--==================================================================
-- DESTROY OLD UI IF EXISTS
--==================================================================
local old = playerGui:FindFirstChild("StealGui")
if old then old:Destroy() end

--==================================================================
-- CREATE UI
--==================================================================
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "StealGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

-- Main panel — anchored to RIGHT-CENTER of screen
local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.new(0, 230, 0, 270)
main.AnchorPoint = Vector2.new(1, 0.5)          -- anchor to right edge
main.Position = UDim2.new(1, -20, 0.5, 0)       -- 20px from right, vertically centered
main.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
main.BorderSizePixel = 0
main.Visible = true                              -- always visible
main.Active = true                               -- allow dragging
main.Parent = screenGui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 10)
mainCorner.Parent = main

local mainStroke = Instance.new("UIStroke")
mainStroke.Color = Color3.fromRGB(0, 170, 255)
mainStroke.Thickness = 2
mainStroke.Parent = main

-- Title bar
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 38)
title.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
title.BorderSizePixel = 0
title.Text = "  ⚡ Area12 Steal"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 16
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = main

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 10)
titleCorner.Parent = title

-- Status label
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 32)
status.Position = UDim2.new(0, 10, 0, 46)
status.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
status.BorderSizePixel = 0
status.Text = "Ready."
status.TextColor3 = Color3.fromRGB(150, 255, 150)
status.TextSize = 13
status.Font = Enum.Font.Gotham
status.Parent = main

local statusCorner = Instance.new("UICorner")
statusCorner.CornerRadius = UDim.new(0, 5)
statusCorner.Parent = status

-- Button builder
local function createButton(text, color, yPos)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 38)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = color
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 15
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = true
    btn.Parent = main

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Transparency = 0.7
    s.Parent = btn

    return btn
end

local teleportBtn = createButton("📍 Teleport to Area12", Color3.fromRGB(0, 140, 220), 88)
local stealBtn    = createButton("💰 Steal Everything",   Color3.fromRGB(220, 130, 0), 132)
local comboBtn    = createButton("🚀 Teleport + Steal",   Color3.fromRGB(160, 40, 200), 176)
local closeBtn    = createButton("❌ Hide",               Color3.fromRGB(180, 40, 40), 220)

--==================================================================
-- DRAG SUPPORT (drag title bar to move panel)
--==================================================================
do
    local dragging, dragInput, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--==================================================================
-- CORE LOGIC
--==================================================================
local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color or Color3.fromRGB(150, 255, 150)
end

local function getArea12()
    local target = workspace:FindFirstChild(TARGET_NAME)
    if not target then return nil, "Target not found" end
    local lm1 = target:FindFirstChild("LevelMap1")
    if not lm1 then return nil, "LevelMap1 missing" end
    local map = lm1:FindFirstChild("map")
    if not map then return nil, "map missing" end
    local map12 = map:FindFirstChild("Map12")
    if not map12 then return nil, "Map12 missing" end
    local area12 = map12:FindFirstChild("Area12")
    if not area12 then return nil, "Area12 missing" end
    return area12
end

local function enableInstantE()
    local area12 = getArea12()
    if not area12 then return end
    for _, obj in ipairs(area12:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            obj.HoldDuration = 0
        end
    end
end

local function teleportToArea12()
    local area12, err = getArea12()
    if not area12 then
        setStatus("❌ " .. err, Color3.fromRGB(255, 100, 100))
        return false
    end
    local char = player.Character
    if not char then
        setStatus("❌ No character", Color3.fromRGB(255, 100, 100))
        return false
    end

    local targetPart
    if area12:IsA("BasePart") then
        targetPart = area12
    elseif area12:IsA("Model") then
        targetPart = area12.PrimaryPart or area12:FindFirstChildWhichIsA("BasePart", true)
    else
        targetPart = area12:FindFirstChildWhichIsA("BasePart", true)
    end

    if not targetPart then
        setStatus("❌ No part found", Color3.fromRGB(255, 100, 100))
        return false
    end

    char:PivotTo(CFrame.new(targetPart.Position + Vector3.new(0, 3, 0)))
    setStatus("✅ Teleported!", Color3.fromRGB(150, 255, 150))
    return true
end

local function firePrompt(prompt)
    if fireproximityprompt then
        pcall(fireproximityprompt, prompt)
        return true
    end
    local ok = pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration)
        prompt:InputHoldEnd()
    end)
    return ok
end

local function stealEverything()
    local area12, err = getArea12()
    if not area12 then
        setStatus("❌ " .. err, Color3.fromRGB(255, 100, 100))
        return 0
    end
    local count = 0
    for _, obj in ipairs(area12:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled and obj.Parent then
            if firePrompt(obj) then count += 1 end
        end
    end
    setStatus(("💰 Fired %d prompts"):format(count), Color3.fromRGB(255, 220, 100))
    return count
end

--==================================================================
-- BUTTON HANDLERS
--==================================================================
teleportBtn.MouseButton1Click:Connect(function()
    enableInstantE()
    teleportToArea12()
end)

stealBtn.MouseButton1Click:Connect(function()
    enableInstantE()
    stealEverything()
end)

comboBtn.MouseButton1Click:Connect(function()
    enableInstantE()
    if teleportToArea12() then
        task.wait(0.4)
        for i = 1, COLLECT_LOOPS do
            if not player.Character then break end
            stealEverything()
            setStatus(("🚀 Stealing %d/%d"):format(i, COLLECT_LOOPS), Color3.fromRGB(200, 160, 255))
            task.wait(COLLECT_DELAY)
        end
        setStatus("✅ Done!", Color3.fromRGB(150, 255, 150))
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    main.Visible = false
    -- Re-show after 1 second so you don't lose it
    task.wait(1)
    main.Visible = true
end)

--==================================================================
-- KEYBINDS
--==================================================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E then
        enableInstantE()
        if teleportToArea12() then
            task.wait(0.3)
            stealEverything()
        end
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
    end
end)

--==================================================================
-- INIT
--==================================================================
enableInstantE()
setStatus("Loaded ✔", Color3.fromRGB(150, 255, 150))
print("[StealGui] Loaded — panel shown at right-center.")
