-- Button builder
local function makeBtn(text, color, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 38)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = color
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.TextSize = 15
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = true
    b.Parent = main
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(255, 255, 255)
    s.Transparency = 0.7
    return b
end

local teleportBtn = makeBtn("📍 Teleport to Area12", Color3.fromRGB(0, 140, 220), 88)
local stealBtn    = makeBtn("💰 Steal Everything",   Color3.fromRGB(220, 130, 0), 132)
local comboBtn    = makeBtn("🚀 Teleport + Steal",   Color3.fromRGB(160, 40, 200), 176)
local closeBtn    = makeBtn("❌ Hide",               Color3.fromRGB(180, 40, 40), 220)

--==================================================================
-- DRAG SUPPORT
--==================================================================
do
    local dragging, dragInput, dragStart, startPos
    title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

--==================================================================
-- CORE LOGIC
--==================================================================
local function setStatus(t, c)
    status.Text = t
    status.TextColor3 = c or Color3.fromRGB(150, 255, 150)
end

local function getArea12()
    local target = workspace:FindFirstChild(TARGET_NAME)
    if not target then return nil, "Target not found" end
    local lm1 = target:FindFirstChild("LevelMap1")
    if not lm1 then return nil, "LevelMap1 missing" end
    local map = lm1:FindFirstChild("map")
    if not map then return nil, "map missing" end
    local map12 = map:FindFirstChild("Map12")
    if not map12 then return nil, "Map12 missing" end
    local area12 = map12:FindFirstChild("Area12")
    if not area12 then return nil, "Area12 missing" end
    return area12
end

local function enableInstantE()
    local area12 = getArea12()
    if not area12 then return end
    for _, obj in ipairs(area12:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            pcall(function() obj.HoldDuration = 0 end)
        end
    end
end

local function teleportToArea12()
    local area12, err = getArea12()
    if not area12 then
        setStatus("❌ " .. err, Color3.fromRGB(255, 100, 100))
        return false
    end
    local char = player.Character
    if not char then
        setStatus("❌ No character", Color3.fromRGB(255, 100, 100))
        return false
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        setStatus("❌ No HRP", Color3.fromRGB(255, 100, 100))
        return false
    end

    local targetPart
    if area12:IsA("BasePart") then
        targetPart = area12
    elseif area12:IsA("Model") then
        targetPart = area12.PrimaryPart or area12:FindFirstChildWhichIsA("BasePart", true)
    else
        targetPart = area12:FindFirstChildWhichIsA("BasePart", true)
    end

    if not targetPart then
        setStatus("❌ No part to land on", Color3.fromRGB(255, 100, 100))
        return false
    end

    char:PivotTo(CFrame.new(targetPart.Position + Vector3.new(0, 3, 0)))
    hrp.Velocity = Vector3.zero
    setStatus("✅ Teleported!", Color3.fromRGB(150, 255, 150))
    return true
end

local function stealEverything()
    local area12, err = getArea12()
    if not area12 then
        setStatus("❌ " .. err, Color3.fromRGB(255, 100, 100))
        return 0
    end
    local count = 0
    for _, obj in ipairs(area12:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local ok = pcall(fireproximityprompt, obj)
            if ok then count += 1 end
        end
    end
    setStatus(("💰 Fired %d prompts"):format(count), Color3.fromRGB(255, 220, 100))
    return count
end

--==================================================================
-- BUTTON HANDLERS
--==================================================================
teleportBtn.MouseButton1Click:Connect(function()
    enableInstantE()
    teleportToArea12()
end)

stealBtn.MouseButton1Click:Connect(function()
    enableInstantE()
    stealEverything()
end)

comboBtn.MouseButton1Click:Connect(function()
    enableInstantE()
    if teleportToArea12() then
        task.wait(0.4)
        for i = 1, COLLECT_LOOPS do
            if not player.Character then break end
            stealEverything()
            setStatus(("🚀 Stealing %d/%d"):format(i, COLLECT_LOOPS), Color3.fromRGB(200, 160, 255))
            task.wait(COLLECT_DELAY)
        end
        setStatus("✅ Done!", Color3.fromRGB(150, 255, 150))
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    main.Visible = false
    task.wait(1)
    main.Visible = true
end)

--==================================================================
-- KEYBINDS
--==================================================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E then
        enableInstantE()
        if teleportToArea12() then
            task.wait(0.3)
            stealEverything()
        end
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
    end
end)

--==================================================================
-- INIT
--==================================================================
enableInstantE()

-- Re-apply instant-E periodically in case prompts respawn
task.spawn(function()
    while task.wait(3) do
        enableInstantE()
    end
end)

-- Verify the area name and report back
local area12, err = getArea12()
if area12 then
    setStatus("✅ Area12 found", Color3.fromRGB(150, 255, 150))
    print("[StealGui] Area12 found:", area12:GetFullName())
else
    setStatus("❌ " .. err, Color3.fromRGB(255, 100, 100))
    warn("[StealGui] " .. err)
    -- Print workspace children so you can find the real name
    print("[StealGui] Workspace children:")
    for _, v in ipairs(workspace:GetChildren()) do
        print("  -", v.Name)
    end
end

